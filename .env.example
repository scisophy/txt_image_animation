# 复制为 .env，并填入火山方舟控制台生成的 API Key。
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=

# 火山方舟 OpenAI 兼容接口及模型。模型必须已对当前账号开放。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-2-0-lite-260215
ARK_VISION_MODEL=doubao-seed-2-0-lite-260215
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2560x1440
ARK_IMAGE_WATERMARK=false

# 可选：动画参数
# POINT_DURATION=4
# TRANSITION_DURATION=0.8
# INTRO_DURATION=2
# OUTRO_DURATION=2
# SERVER_PORT=8000
