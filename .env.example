# 复制为 .env 并填入你的 OPENAI 官网的 API Key
# 获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# 可选：自定义模型与参数
# PLANNER_MODEL=gpt-5.6-sol
# IMAGE_MODEL=gpt-image-2
# IMAGE_SIZE=2048x1152
# IMAGE_QUALITY=high
# POINT_DURATION=4
# TRANSITION_DURATION=0.8
# INTRO_DURATION=2
# OUTRO_DURATION=2
# SERVER_PORT=8000
